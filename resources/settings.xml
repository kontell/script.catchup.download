<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="script.catchup.download">

    <!-- The Account category is plugin.video.kofin's: the same hidden
         credential record, discovery, and Quick Connect or password sign-in. -->
    <category id="account" label="30050" help="30051">
      <group id="1">
        <!-- Hidden state written by catchup.settings.Credentials only. -->
        <setting id="isLoggedIn" type="boolean">
          <level>4</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="serverId" type="string">
          <level>4</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"/>
        </setting>
        <setting id="userId" type="string">
          <level>4</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"/>
        </setting>
        <setting id="accessToken" type="string">
          <level>4</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"/>
        </setting>
        <setting id="deviceId" type="string">
          <level>4</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"/>
        </setting>

        <setting id="serverAddress" type="string" label="30052" help="30053">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <dependencies>
            <dependency type="enable">
              <condition operator="is" setting="isLoggedIn">false</condition>
            </dependency>
          </dependencies>
          <control type="edit" format="string"/>
        </setting>
        <!-- close=true as in Kofin: Kodi saves and closes the dialog before
             the script writes serverAddress, which a still-open dialog would
             revert when the user backs out. The script reopens settings. -->
        <setting id="findServers" type="string" label="30825" help="30826">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <dependencies>
            <dependency type="visible">
              <condition operator="is" setting="isLoggedIn">false</condition>
            </dependency>
          </dependencies>
          <control type="button" format="action">
            <data>RunScript(script.catchup.download,findservers)</data>
            <close>true</close>
          </control>
        </setting>
        <setting id="loginButton" type="string" label="30054" help="30055">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <dependencies>
            <dependency type="visible">
              <condition operator="is" setting="isLoggedIn">false</condition>
            </dependency>
          </dependencies>
          <control type="button" format="action">
            <data>RunScript(script.catchup.download,login)</data>
            <close>true</close>
          </control>
        </setting>
        <setting id="serverName" type="string" label="30056" help="30057">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <enable>false</enable>
          <dependencies>
            <dependency type="visible">
              <condition operator="is" setting="isLoggedIn">true</condition>
            </dependency>
          </dependencies>
          <control type="edit" format="string"/>
        </setting>
        <setting id="displayUser" type="string" label="30058" help="30059">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <enable>false</enable>
          <dependencies>
            <dependency type="visible">
              <condition operator="is" setting="isLoggedIn">true</condition>
            </dependency>
          </dependencies>
          <control type="edit" format="string"/>
        </setting>
        <setting id="logoutButton" type="string" label="30062" help="30063">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <dependencies>
            <dependency type="visible">
              <condition operator="is" setting="isLoggedIn">true</condition>
            </dependency>
          </dependencies>
          <control type="button" format="action">
            <data>RunScript(script.catchup.download,logout)</data>
            <close>true</close>
          </control>
        </setting>
      </group>
    </category>

    <category id="recording" label="30120" help="30121">
      <group id="1">
        <setting id="padBeforeMinutes" type="integer" label="30122" help="30123">
          <level>0</level>
          <default>0</default>
          <constraints>
            <minimum>0</minimum>
            <step>1</step>
            <maximum>30</maximum>
          </constraints>
          <control type="spinner" format="integer"/>
        </setting>
        <setting id="padAfterMinutes" type="integer" label="30124" help="30125">
          <level>0</level>
          <default>0</default>
          <constraints>
            <minimum>0</minimum>
            <step>1</step>
            <maximum>120</maximum>
          </constraints>
          <control type="spinner" format="integer"/>
        </setting>
        <setting id="showDownloads" type="string" label="30126" help="30127">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="button" format="action">
            <data>RunScript(script.catchup.download,downloads)</data>
            <close>true</close>
          </control>
        </setting>
      </group>
    </category>

  </section>
</settings>
